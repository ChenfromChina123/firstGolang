[Unit]
Description=FileSync Server
After=network.target redis.service docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/filesync
ExecStart=/opt/filesync/server
Environment=DOMAIN=aistudy.icu
Environment=PORT=8888
Environment=DATA_DIR=/opt/filesync/data
Environment=STORAGE_TYPE=local
Environment=WEB_DIR=/opt/filesync/web
Environment=CERT_DIR=/opt/filesync/certs
Environment=MYSQL_DSN=filesync:***REMOVED_DB_PASSWORD***@tcp(127.0.0.1:13306)/filesync?parseTime=true&loc=Local&charset=utf8mb4
Environment=REDIS_SENTINEL_ADDRS=127.0.0.1:36379,127.0.0.1:36380,127.0.0.1:36381
Environment=REDIS_SENTINEL_MASTER=mymaster
Environment=REDIS_PASSWORD=redis123
Environment=REDIS_DB=0
Environment=JWT_SECRET=***REMOVED_JWT_SECRET***
Environment=FILESYNC_INITIAL_USERNAME=admin
Environment=FILESYNC_INITIAL_PASSWORD=***REMOVED_PASSWORD***
Environment=SMTP_HOST=smtp.qiye.aliyun.com
Environment=SMTP_PORT=465
Environment=SMTP_USER=px-ai@aistudy.icu
Environment=SMTP_PASS=C2OzrpugzVCEMN6F
Environment="SMTP_FROM=FileSync <px-ai@aistudy.icu>"
Environment=APP_BASE_URL=https://aistudy.icu
# === 阿里云 OSS 对象存储（华南1-深圳） ===
# 启用后新文件写入 OSS，旧文件保留本地（混合存储模式）
Environment=S3_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
Environment=S3_REGION=oss-cn-shenzhen
Environment=S3_BUCKET=aistudy-filesync
Environment=S3_ACCESS_KEY=***REMOVED_AK_ID***
Environment=S3_SECRET_KEY=***REMOVED_AK_SECRET***
Environment=S3_USE_SSL=true
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/filesync/server.log
StandardError=append:/opt/filesync/server.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
